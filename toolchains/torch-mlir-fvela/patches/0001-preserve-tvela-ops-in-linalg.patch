index 00000000..73aa8c11
--- /dev/null
+++ b/lib/Dialect/TorchConversion/Transforms/ConvertTVelaOps.cpp
@@ -0,0 +1,171 @@
+//===----------------------------------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Also available under a BSD-style license. See LICENSE.
+//
+//===----------------------------------------------------------------------===//
+
+#include "torch-mlir/Dialect/TorchConversion/Transforms/Passes.h"
+
+#include "mlir/IR/BuiltinTypes.h"
+#include "mlir/IR/Dialect.h"
+#include "mlir/Transforms/DialectConversion.h"
+#include "torch-mlir/Dialect/Torch/IR/TorchDialect.h"
+#include "torch-mlir/Dialect/Torch/IR/TorchOps.h"
+#include "torch-mlir/Dialect/TorchConversion/Transforms/BackendTypeConversion.h"
+
+using namespace mlir;
+using namespace mlir::torch;
+
+namespace {
+
+constexpr StringLiteral kTorchVFRopeOpName = "torch.tvela.vfrope_q15_chunk";
+constexpr StringLiteral kTVelaVFRopeOpName = "tvela.vfrope_q15_chunk";
+constexpr StringLiteral kTorchTernaryMatmulOpName =
+    "torch.tvela.ternary_matmul";
+constexpr StringLiteral kTVelaTernaryMatmulOpName = "tvela.ternary_matmul";
+constexpr int64_t kMaxConfigField = 0xffff;
+
+class TVelaCarrierDialect final : public Dialect {
+public:
+  explicit TVelaCarrierDialect(MLIRContext *context)
+      : Dialect(getDialectNamespace(), context,
+                TypeID::get<TVelaCarrierDialect>()) {
+    allowUnknownOperations();
+  }
+
+  static StringRef getDialectNamespace() { return "tvela"; }
+};
+
+FailureOr<int64_t> getConstantInt(Value value) {
+  auto constant = value.getDefiningOp<Torch::ConstantIntOp>();
+  if (!constant)
+    return failure();
+  return constant.getValue();
+}
+
+class ConvertVFRopeOp final : public OpConversionPattern<Torch::OperatorOp> {
+public:
+  using OpConversionPattern::OpConversionPattern;
+
+  LogicalResult
+  matchAndRewrite(Torch::OperatorOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    if (op.getName() != kTorchVFRopeOpName)
+      return rewriter.notifyMatchFailure(op, "not the T-Vela VFROPE op");
+    if (op.getNumOperands() != 3 || op.getNumResults() != 1)
+      return op.emitOpError(
+          "expects operands (tensor, m, idx) and one tensor result");
+
+    FailureOr<int64_t> m = getConstantInt(op.getOperand(1));
+    FailureOr<int64_t> idx = getConstantInt(op.getOperand(2));
+    if (failed(m) || failed(idx))
+      return op.emitOpError("requires constant integer m and idx operands");
+    if (*m < 0 || *m > kMaxConfigField || *idx < 0 || *idx > kMaxConfigField)
+      return op.emitOpError("requires m and idx in the range 0..65535");
+
+    Type convertedResult = getTypeConverter()->convertType(op.getType(0));
+    auto tensorType = dyn_cast_or_null<RankedTensorType>(convertedResult);
+    if (!tensorType || tensorType.getShape() != ArrayRef<int64_t>{8} ||
+        !tensorType.getElementType().isSignlessInteger(16))
+      return op.emitOpError("requires a tensor<8xi16> result");
+
+    Value input = adaptor.getOperands().front();
+    if (input.getType() != tensorType)
+      return op.emitOpError(
+          "requires matching tensor<8xi16> input and result types");
+
+    OperationState state(op.getLoc(), kTVelaVFRopeOpName);
+    state.addOperands(input);
+    state.addTypes(tensorType);
+    state.addAttribute("m", rewriter.getI64IntegerAttr(*m));
+    state.addAttribute("idx", rewriter.getI64IntegerAttr(*idx));
+    Operation *replacement = rewriter.create(state);
+    rewriter.replaceOp(op, replacement->getResults());
+    return success();
+  }
+};
+
+class ConvertTernaryMatmulOp final
+    : public OpConversionPattern<Torch::OperatorOp> {
+public:
+  using OpConversionPattern::OpConversionPattern;
+
+  LogicalResult
+  matchAndRewrite(Torch::OperatorOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    if (op.getName() != kTorchTernaryMatmulOpName)
+      return rewriter.notifyMatchFailure(op,
+                                         "not the T-Vela ternary matmul op");
+    if (op.getNumOperands() != 2 || op.getNumResults() != 1)
+      return op.emitOpError(
+          "expects operands (lhs, packed_rhs) and one tensor result");
+
+    Type convertedResult = getTypeConverter()->convertType(op.getType(0));
+    auto resultType = dyn_cast_or_null<RankedTensorType>(convertedResult);
+    if (!resultType || resultType.getShape() != ArrayRef<int64_t>{1, 64} ||
+        !resultType.getElementType().isSignlessInteger(8))
+      return op.emitOpError("requires a tensor<1x64xi8> result");
+
+    Value lhs = adaptor.getOperands()[0];
+    Value packedRhs = adaptor.getOperands()[1];
+    auto lhsType = dyn_cast<RankedTensorType>(lhs.getType());
+    auto packedRhsType = dyn_cast<RankedTensorType>(packedRhs.getType());
+    if (!lhsType || lhsType.getShape() != ArrayRef<int64_t>{1, 64} ||
+        !lhsType.getElementType().isSignlessInteger(8))
+      return op.emitOpError("requires lhs to be tensor<1x64xi8>");
+    if (!packedRhsType ||
+        packedRhsType.getShape() != ArrayRef<int64_t>{64, 16} ||
+        !packedRhsType.getElementType().isSignlessInteger(8))
+      return op.emitOpError("requires packed_rhs to be tensor<64x16xi8>");
+
+    OperationState state(op.getLoc(), kTVelaTernaryMatmulOpName);
+    state.addOperands({lhs, packedRhs});
+    state.addTypes(resultType);
+    Operation *replacement = rewriter.create(state);
+    rewriter.replaceOp(op, replacement->getResults());
+    return success();
+  }
+};
+
+class ConvertTVelaOpsPass final
+    : public PassWrapper<ConvertTVelaOpsPass,
+                         InterfacePass<FunctionOpInterface>> {
+public:
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(ConvertTVelaOpsPass)
+
+  void getDependentDialects(DialectRegistry &registry) const override {
+    registry.insert<Torch::TorchDialect, TVelaCarrierDialect>();
+    TorchConversion::getBackendTypeConversionDependentDialects(registry);
+  }
+
+  void runOnOperation() override {
+    MLIRContext *context = &getContext();
+    TypeConverter typeConverter;
+    typeConverter.addConversion([](Type type) { return type; });
+
+    ConversionTarget target(*context);
+    target.addLegalDialect<Torch::TorchDialect, TVelaCarrierDialect>();
+    TorchConversion::setupBackendTypeConversion(target, typeConverter);
+    target.addDynamicallyLegalOp<Torch::OperatorOp>([](Torch::OperatorOp op) {
+      return op.getName() != kTorchVFRopeOpName &&
+             op.getName() != kTorchTernaryMatmulOpName;
+    });
+
+    RewritePatternSet patterns(context);
+    patterns.add<ConvertVFRopeOp, ConvertTernaryMatmulOp>(typeConverter,
+                                                          context);
+    if (failed(applyPartialConversion(getOperation(), target,
+                                      std::move(patterns))))
+      signalPassFailure();
+  }
+};
+
+} // namespace
+
+std::unique_ptr<InterfacePass<FunctionOpInterface>>
+mlir::torch::TorchConversion::createConvertTVelaOpsPass() {
+  return std::make_unique<ConvertTVelaOpsPass>();
+}
